{
  "name": "holding-digital-architecture",
  "version": "1.0.0",
  "private": true,
  "description": "15-минутный доклад о цифровой архитектуре современного промышленного энергохолдинга",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 43217",
    "build": "next build && node scripts/pack-timeweb.mjs",
    "build:timeweb": "NEXT_PUBLIC_BASE_PATH=/holding-architecture next build && TIMEWEB_SUBDIR=holding-architecture node scripts/pack-timeweb.mjs",
    "pack:html": "npm run build:timeweb && node scripts/pack-html.mjs",
    "start:html": "npx --yes serve out --listen tcp://0.0.0.0:43218",
    "start": "npx --yes serve out --listen tcp://0.0.0.0:43217",
    "pack:port": "next build && TIMEWEB_SUBDIR=holding-architecture node scripts/pack-timeweb.mjs && node -e \"require('fs').copyFileSync('holding-deck-timeweb.zip','holding-architecture-port.zip')\"",
    "deploy:timeweb-port": "bash scripts/deploy-timeweb-port.sh",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
